APP_ORIGIN=http://localhost:3000
OWNER_PASSWORD_HASH=REPLACE_WITH_OUTPUT_OF_OWNER_PASSWORD_COMMAND
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Development and tests: collection.json plus posters/ live in this folder.
# Never point this at production data; production uses Vercel Blob.
DATA_DIR=data
# Production only: token from the Vercel Blob store connected to the project.
# Vercel injects this automatically for connected Blob stores.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
